# Find your connection string (Neon / Supabase / Azure Flexible Server / local
# Postgres). The server refuses to boot without it.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"
# Long random secret (>= 32 chars). Changing it invalidates all sessions.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
# Public host the app calls, e.g. https://api.example.com. MUST match the real
# host — session cookies and auth origin checks depend on it.
BETTER_AUTH_URL="http://localhost:3005"
PORT="3005"
# Comma-separated browser origins allowed to call the API with credentials.
# Native apps are unaffected by CORS. A bare "*" reflects the request origin.
CLIENT_ORIGIN="http://localhost:5173"
# Deep link (or https URL) opened for password resets. Sent as `redirectTo`
# by the iOS client and auto-trusted by the server.
PASSWORD_RESET_URL="lnreader://reset-password"
# Max JSON body size for PUT /api/sync (large libraries need headroom).
SYNC_BODY_LIMIT="10mb"
# Auth rate limit: max requests per IP per window.
RATE_LIMIT_AUTH_MAX="60"
RATE_LIMIT_AUTH_WINDOW_MS="600000"
